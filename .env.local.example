# 관리자 로그인 정보
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# JWT Secret (로그인 세션 암호화용) - 랜덤하게 변경하세요
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 로그인 페이로드 비대칭 암호화 키 (RSA-OAEP, 2048bit)
# 생성 방법:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# PEM 을 한 줄로 넣을 때는 개행을 \n 으로 이스케이프 해서 넣어주세요.
# (dotenv-expand 는 $ 를 특수처리하므로 필요 시 \$ 로 이스케이프)
NEXT_PUBLIC_LOGIN_PUBLIC_KEY=
LOGIN_PRIVATE_KEY=

# GCP 프로젝트 정보
GOOGLE_APPLICATION_CREDENTIALS=./what-is-pill-2435ec243d4b.json

# Cloudflare Workers Notices API (서버 API route 에서만 참조 → prefix 없이 서버 전용)
CLOUD_FLARE_WORKERS_NOTICES_API_URL=https://wip-notice.knut043mbm.workers.dev
CLOUD_FLARE_SECRET_KEY=

# GCP Cloud Function - 초기 정보 (서버 API route 에서만 참조)
GOOGLE_CLOUD_INIT_INFO_URL=https://asia-northeast1-what-is-pill.cloudfunctions.net/initial-info
